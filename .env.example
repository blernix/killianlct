# Clés publiques EmailJS — REQUISES AU BUILD.
# Le site est un export statique : ces valeurs sont écrites en dur dans le JS
# au moment du `npm run build`. Sans elles, le formulaire de contact s'affiche
# normalement mais l'envoi échoue en silence (aucun mail n'est envoyé).
#
# Dashboard : https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
